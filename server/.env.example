# Server Port
PORT=3001

# Decart API Key (keep this private on the server, never expose to client/extension)
# Get your API key at https://platform.decart.ai
DECART_API_KEY=your_decart_api_key_here

# Optional: Restrict allowed extension ID or origins (comma-separated).
# In development, leave blank or set to '*' or 'chrome-extension://*'
ALLOWED_ORIGINS=*
